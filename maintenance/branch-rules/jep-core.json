{
  "name": "main: PR and required CI",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "merge",
          "squash",
          "rebase"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "Python 3.10",
            "integration_id": 15368
          },
          {
            "context": "Python 3.11",
            "integration_id": 15368
          },
          {
            "context": "Python 3.12",
            "integration_id": 15368
          },
          {
            "context": "Python 3.13",
            "integration_id": 15368
          },
          {
            "context": "Legacy 0.6 TypeScript / Node 20",
            "integration_id": 15368
          },
          {
            "context": "Legacy 0.6 TypeScript / Node 22",
            "integration_id": 15368
          },
          {
            "context": "Legacy 0.6 Go conformance verifier",
            "integration_id": 15368
          },
          {
            "context": "Legacy 0.6 cross-language interop",
            "integration_id": 15368
          },
          {
            "context": "installed-wheel (ubuntu-latest)",
            "integration_id": 15368
          },
          {
            "context": "installed-wheel (windows-latest)",
            "integration_id": 15368
          },
          {
            "context": "installed-wheel (macos-latest)",
            "integration_id": 15368
          },
          {
            "context": "signed-artifacts",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
